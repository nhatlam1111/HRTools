{
  "SqlServer": {
    "ConnectionString": "Server=DLAP-1178\\SQLEXPRESS;Database=test;Trusted_Connection=True;"
  },
  "ApiSettings": {
    "BaseUrl": "http://localhost:4003/api",
    "Endpoint": "dso/bulkinsertpro",
    "MaxRowPerRequest": 500,
    "TimeoutSeconds": 120
  },
  "SyncStateSettings": {
    "DatabasePath": "sync-state.db",
    "EnableTracking": true,
    "RetentionDays": 30,
    "AutoCleanup": true,
    "HashAlgorithm": "SHA256"
  },
  "SyncJobs": [
    {
      "JobName": "SyncAttendance",
      "Enabled": true,
      "Query": "SELECT ID as USER_ID, WORK_DT, TIME, LOCATION FROM test_time WHERE WORK_DT >= convert(varchar(8),DATEADD(day, -7, GETDATE()), 112)",
      "Procedure": "HR_INSERT_ATTENDANCE",
      "ParameterColumns": [ "USER_ID", "WORK_DT", "TIME", "LOCATION" ],
      "UniqueKeyColumns": [ "USER_ID", "WORK_DT", "TIME" ],
      "SkipSyncedRecords": true,
      "RevalidateAfterDays": 0,
      "Description": "Đồng bộ dữ liệu chấm công"
    }
  ],
  "SchedulerSettings": {
    "IntervalMinutes": 5,
    "EnableScheduler": false,
    "RunOnStartup": true
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/sync-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
