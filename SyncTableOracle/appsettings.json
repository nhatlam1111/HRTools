{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning"
    }
  },
  "SyncSettings": {
    "LookbackDays": 2,
    "RunIntervalMinutes": 60,
    "BatchSize": 500,
    "Source": {
      "Tns": "(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=SOURCE_HOST)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=SOURCE_SERVICE)))",
      "UserId": "source_user",
      "Password": "source_password"
    },
    "Destination": {
      "Tns": "(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=DEST_HOST)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=DEST_SERVICE)))",
      "UserId": "dest_user",
      "Password": "dest_password"
    },
    "Table": {
      "Name": "THR_TERMINAL_LOGS",
      "DateColumn": "EVENT_TIME",
      "KeyColumns": [
        "TERMINAL_ID",
        "USER_ID",
        "EVENT_TIME"
      ],
      "Columns": [
        "TERMINAL_ID",
        "USER_ID",
        "USER_NAME",
        "CARD_ID",
        "EVENT_TIME",
        "AUTH_TYPE",
        "AUTH_RESULT",
        "CREATED_DATE"
      ]
    }
  }
}
